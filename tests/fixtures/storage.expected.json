{
  "capabilities": ["storage"],
  "resolution": {},
  "preserve_verbatim": {
    "unknown_structural": [],
    "lang_namespaces": {
      "top_level": [],
      "per_dataset": {}
    }
  },
  "storage": {
    "default": "$data",
    "scope": "demoproj",
    "datasets": {
      "bigsim": "$data",
      "scratch_run": "$cache",
      "big": "$scratch",
      "derived_table": "$cache/derived"
    },
    "local_paths": {
      "pinned": "$scratch/exact/file.nc"
    },
    "scopes": {
      "bigsim": "cmip",
      "scratch_run": ""
    },
    "folders": {
      "builtin": ["data", "cache", "repo"],
      "user": ["scratch"],
      "host_patterns": ["login*.hpc.edu"],
      "profiles": []
    }
  }
}
